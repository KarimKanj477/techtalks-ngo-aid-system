﻿@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">

        <h1 class="fw-bold display-5">
            Admin Dashboard
        </h1>

        <p class="text-muted fs-5">
            NGO Aid Distribution Accountability System
        </p>

    </div>


    <!-- STATISTICS SECTION -->
    <div class="row g-4 mb-5">

        <!-- TOTAL REQUESTS -->
        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-primary text-white border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-folder dashboard-stat-icon"></i>

                    <h2 class="fw-bold mt-3">
                        @ViewBag.TotalRequests
                    </h2>

                    <p class="mb-0">
                        Total Requests
                    </p>

                </div>

            </div>

        </div>


        <!-- PENDING -->
        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-warning text-dark border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-clock-history dashboard-stat-icon"></i>

                    <h2 class="fw-bold mt-3">
                        @ViewBag.PendingRequests
                    </h2>

                    <p class="mb-0">
                        Pending
                    </p>

                </div>

            </div>

        </div>


        <!-- APPROVED -->
        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-success text-white border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-check-circle dashboard-stat-icon"></i>

                    <h2 class="fw-bold mt-3">
                        @ViewBag.ApprovedRequests
                    </h2>

                    <p class="mb-0">
                        Approved
                    </p>

                </div>

            </div>

        </div>


        <!-- REJECTED -->
        <div class="col-lg-3 col-md-6">

            <div class="card stat-card bg-danger text-white border-0 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-x-circle dashboard-stat-icon"></i>

                    <h2 class="fw-bold mt-3">
                        @ViewBag.RejectedRequests
                    </h2>

                    <p class="mb-0">
                        Rejected
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ADMIN ACTION CARDS -->
    <div class="row g-4 justify-content-center">

        <!-- MANAGE REQUESTS -->
        <div class="col-lg-5 col-md-6">

            <div class="card dashboard-card shadow-sm border-0 h-100">

                <div class="card-body text-center p-5">

                    <div class="icon-circle bg-primary-subtle mb-4">
                        <i class="bi bi-list-check text-primary dashboard-icon"></i>
                    </div>

                    <h4 class="fw-bold mb-3">
                        Manage Aid Requests
                    </h4>

                    <p class="text-muted mb-4">
                        Review, approve, or reject aid requests.
                    </p>

                    <a asp-controller="Admin"
                           asp-action="ManageRequests"
                           class="btn btn-primary rounded-pill px-4">
                        Open Requests
                    </a>

                </div>

            </div>

        </div>


        <!-- MANAGE USERS -->
        <div class="col-lg-5 col-md-6">

            <div class="card dashboard-card shadow-sm border-0 h-100">

                <div class="card-body text-center p-5">

                    <div class="icon-circle bg-success-subtle mb-4">
                        <i class="bi bi-people-fill text-success dashboard-icon"></i>
                    </div>

                    <h4 class="fw-bold mb-3">
                        Manage Users
                    </h4>

                    <p class="text-muted mb-4">
                        View registered users and manage their roles.
                    </p>

                    <a asp-controller="Admin"
                           asp-action="ManageUsers"
                           class="btn btn-success rounded-pill px-4">
                        Open Users
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>