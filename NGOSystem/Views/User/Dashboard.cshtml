@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">
            Welcome, @Context.Session.GetString("Username")
        </h1>

        <p class="text-muted">
            NGO Aid Distribution Accountability System
        </p>
    </div>

    <div class="row g-4 justify-content-center">

        <!-- VIEW REQUESTS -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100 shadow-sm border-0">

                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <i class="bi bi-list-check text-primary dashboard-icon"></i>
                    </div>

                    <h4 class="fw-bold mb-3">
                        View Requests
                    </h4>

                    <p class="text-muted mb-4">
                        Browse all available aid requests and updates.
                    </p>

                    <a asp-controller="AidRequest"
                       asp-action="Index"
                       class="btn btn-primary rounded-pill">
                        View Requests
                    </a>

                </div>
            </div>
        </div>

        <!-- REQUEST HELP -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100 shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <div class="icon-circle bg-success-subtle mb-4">
                        <i class="bi bi-heart-fill text-success dashboard-icon"></i>
                    </div>

                    <h4 class="fw-bold mb-3">
                        Request Help
                    </h4>

                    <p class="text-muted mb-4">
                        Submit a new aid request quickly and securely.
                    </p>

                    <a asp-controller="AidRequest"
                       asp-action="Create"
                       class="btn btn-success px-4 rounded-pill">
                        Request
                    </a>

                </div>
            </div>
        </div>

        <!-- MY REQUESTS -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100 shadow-sm border-0">

                <div class="card-body text-center p-5">

                    <div class="icon-circle bg-warning-subtle mb-4">
                        <i class="bi bi-clock-history text-warning dashboard-icon"></i>
                    </div>

                    <h4 class="fw-bold mb-3">
                        My Requests
                    </h4>

                    <p class="text-muted mb-4">
                        Track your submitted requests and status.
                    </p>

                    <a asp-controller="AidRequest"
                       asp-action="MyRequests"
                       class="btn btn-warning text-white px-4 rounded-pill">
                        Track
                    </a>

                </div>
            </div>
        </div>

    </div>
</div>