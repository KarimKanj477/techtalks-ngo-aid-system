@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container mt-5">
    <h2 class="mb-4">Welcome @Context.Session.GetString("Username") </h2>

    <div class="row">

        
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">View Aid Requests</h5>
                    <p class="card-text">See all available aid requests.</p>
                    <a asp-controller="AidRequest" asp-action="Index" class="btn btn-primary">
                        View
                    </a>
                </div>
            </div>
        </div>

      
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Request Help</h5>
                    <p class="card-text">Submit a new aid request.</p>
                    <a asp-controller="AidRequest" asp-action="Create" class="btn btn-success">
                        Request
                    </a>
                </div>
            </div>
        </div>

        
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">My Requests</h5>
                    <p class="card-text">Track your requests and status.</p>
                    <a asp-controller="AidRequest" asp-action="MyRequests" class="btn btn-warning">
                        View
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>